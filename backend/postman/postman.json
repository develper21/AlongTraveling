            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Weekend Trip to Rishikesh (Updated)\",\n  \"estimatedCost\": 3000,\n  \"maxParticipants\": 8\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/:id",
