              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('tripId', res.data._id);",
