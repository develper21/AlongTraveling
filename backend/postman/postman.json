    {
      "name": "🤝 Join Requests",
      "description": "Request-to-join workflow: send, list (per trip / per user), approve, reject, cancel.",
      "item": [
        {
          "name": "Send Join Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('requestId', res.data._id);",
                  "    console.log('Saved requestId:', res.data._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"message\": \"Hi! I would love to join this trip. I have done rafting before.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"]
            },
            "description": "Send a join request for a trip (as the logged-in user). Test script auto-saves `requestId`.\n\n**Rules:** cannot join own trip, cannot join twice, trip must have seats, must not already be a participant.\n\n**Errors:** 400 (full / duplicate / own trip), 404 trip not found."
          }
        },
        {
          "name": "Get Trip Requests (organizer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/trip/:tripId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "trip", ":tripId"],
              "variable": [
                { "key": "tripId", "value": "{{tripId}}" }
              ]
            },
            "description": "Get all join requests for a trip. Protected — meant for the **trip organizer** to review requests (RequestsList UI)."
          }
        },
        {
          "name": "Get My Requests (per user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "user", ":userId"],
              "variable": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Get all join requests **sent by** a user with their statuses (pending / approved / rejected)."
          }
        },
        {
          "name": "Approve Request",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/:id/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id", "approve"],
              "variable": [
                { "key": "id", "value": "{{requestId}}" }
              ]
            },
            "description": "Approve a join request. Requires the **trip organizer's** token — the participant count is updated automatically and the requester is notified via Socket.IO (`request:status-update`)."
          }
        },
        {
          "name": "Reject Request",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/:id/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id", "reject"],
              "variable": [
                { "key": "id", "value": "{{requestId}}" }
              ]
            },
            "description": "Reject a join request. Requires the **trip organizer's** token. The requester receives a status-update notification."
          }
        },
        {
          "name": "Cancel Request",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id"],
              "variable": [
                { "key": "id", "value": "{{requestId}}" }
              ]
            },
            "description": "Cancel (withdraw) a join request. Only the **sender** of the request can cancel it."
          }
        }
      ]
    },
    {
      "name": "💬 Messages",
      "description": "Trip chat messages (REST layer). Real-time delivery happens via Socket.IO (`message:new`).",
      "item": [
        {
          "name": "Get Trip Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/trip/:tripId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "trip", ":tripId"],
              "variable": [
                { "key": "tripId", "value": "{{tripId}}" }
              ]
            },
            "description": "Get the full chat history for a trip (sorted by creation time). Returns `{ success, count, data }` — returns an empty array instead of an error if the trip has no messages.\n\nResponse is cached for 60 seconds (`Cache-Control: public, max-age=60`)."
          }
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('messageId', res.data._id);",
                  "    console.log('Saved messageId:', res.data._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trip\": \"{{tripId}}\",\n  \"content\": \"Hello team! Excited for the trip 🎉\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            },
            "description": "Send a chat message to a trip. Body must contain `trip` (trip ID) and `content` (max 1000 chars). Test script auto-saves `messageId`.\n\n**Errors:** 400 missing trip/content."
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", ":id"],
              "variable": [
                { "key": "id", "value": "{{messageId}}" }
              ]
            },
            "description": "Delete a message. Only the **sender** can delete their own message."
          }
        }
      ]
    }
  ]
}
