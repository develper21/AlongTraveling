                { "key": "status", "value": "upcoming", "disabled": true, "description": "upcoming | ongoing | completed | cancelled" },
                { "key": "search", "value": "", "disabled": true, "description": "Search in title, description, destination" },
                { "key": "page", "value": "1", "description": "Page number (default 1)" },
                { "key": "limit", "value": "10", "description": "Results per page (default 10)" }
              ]
            },
            "description": "Browse all trips. All query params are optional — enable only the filters you need."
          }
        },
